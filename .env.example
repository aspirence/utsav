# ---------------------------------------------------------------------------
# Utsava — environment template. Copy to .env.local and fill in.
# NEVER commit real keys. The service-role key must never reach a client bundle.
# ---------------------------------------------------------------------------

# Supabase — public (safe to expose; RLS is the security boundary)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-local-anon-key"

# Supabase — server only. Bypasses RLS. Server actions / route handlers / Edge Functions only.
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Messaging (plan §S7 — outbox + pgmq drains to these)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
SMS_PROVIDER_API_KEY=""
FCM_SERVER_KEY=""

# Shared secret for the outbox drain endpoint (/api/workers/notifications).
# That worker sends real WhatsApp/SMS messages and runs under the service-role key, so
# the route is closed by default and refuses any request without this header.
WORKER_SECRET=""

# Payments — escrow via a licensed aggregator. Plan §4 said "evaluate Razorpay Route vs
# Cashfree Easy Split at build"; Cashfree was chosen on 2026-07-31. public.payments.aggregator
# already allowed both, so nothing in the schema had to change.
#
# From the Cashfree merchant dashboard → Developers → API Keys. Sandbox and production are
# separate credential pairs against separate hosts, so switching environments is these three
# values, not a code change.
#
# CASHFREE_ENV picks the host: "sandbox" → sandbox.cashfree.com, "production" → api.cashfree.com.
# Left unset the integration is inert and the booking flow behaves exactly as it does today —
# the order is recorded awaiting_payment and staff follow it up.
PAYMENT_AGGREGATOR="cashfree"
CASHFREE_ENV="sandbox"
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""

# The webhook signature is HMAC-SHA256 over (x-webhook-timestamp + raw body), base64, keyed on
# the SECRET KEY above — Cashfree does not issue a separate webhook secret. This is here as its
# own variable so a key rotation can be staged: set it to the old secret while the new one goes
# live on the API side. Blank means "use CASHFREE_SECRET_KEY".
CASHFREE_WEBHOOK_SECRET=""

# Analytics (plan §10 — PostHog + nightly warehouse export)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Admin console (plan §3 — separate deploy, SSO + IP allowlist)
ADMIN_IP_ALLOWLIST=""

# ---------------------------------------------------------------------------
# Local super-admin — ONLY for running the console before a Supabase project exists.
#
# The console requires a login before anything renders. Real staff sign in with email +
# password against Supabase Auth (plan §3) and their role comes from public.staff_roles. With
# no Supabase attached there is no auth server to ask, so these three open the console instead.
#
# THIS BLOCK DISABLES ITSELF once NEXT_PUBLIC_SUPABASE_URL is set — see
# lib/admin-local-auth.ts. It is not a production backdoor and cannot be left switched
# on by accident, because production has Supabase configured and that alone turns it off.
#
# Leave all three blank and the console is LOCKED, which is the correct default. The login page
# then explains what to set.
#
# The session cookie is HMAC-signed with the secret, so a short secret is a forgeable login:
# 32 characters minimum, and generate it rather than inventing it —
#   openssl rand -hex 32
# Everything inside the console is fixtures in this mode. Nothing is written anywhere.
# ---------------------------------------------------------------------------
ADMIN_LOCAL_EMAIL=""
ADMIN_LOCAL_PASSWORD=""
ADMIN_LOCAL_SECRET=""
