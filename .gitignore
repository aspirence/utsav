# dependencies
node_modules/
.pnpm-store/

# builds
.next/
# Alternate build dirs from NEXT_DIST_DIR — see distDir in next.config.ts. A verification build
# uses one of these so it does not corrupt the running dev server's .next.
.next-*/
out/
dist/
build/
*.tsbuildinfo

# env — never commit real keys
.env
.env.local
.env.*.local
!.env.example

# supabase local
supabase/.branches/
supabase/.temp/
supabase/.env

# testing
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# editors / os
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# vercel
.vercel

# Photographs uploaded through the console while developing. Content, not source — and on a real
# deploy these live in Supabase Storage, not on the filesystem. See lib/image-upload.ts.
public/uploads/
